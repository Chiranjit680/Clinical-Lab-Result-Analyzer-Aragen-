# Vision model, served over an OpenAI-compatible API.
#
# VLM_* wins when set; otherwise the INFERENCE_* names are used, so this file
# can be a copy of the analyzer's .env when both point at the same provider.

VLM_BASE_URL=
VLM_API_KEY=
# Must be vision-capable: every tile agent sends an image.
VLM_MODEL=zai-org/glm-5.3-flash

# Used when the VLM_* equivalents above are blank.
INFERENCE_BASE_URL=https://api.hpc-ai.com/inference/v1
INFERENCE_API_KEY=

# GLM-5.3 is a reasoning model and spends tokens thinking before it answers.
# Too little headroom and the reply comes back empty.
VLM_REASONING_HEADROOM=1024
VLM_ATTEMPTS=2
VLM_TIMEOUT_SECONDS=120

# Images are base64-encoded into the request, so this bounds the payload.
VLM_MAX_IMAGE_SIDE=1024

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Set to also write the run log to a file.
VLM_LOG_FILE=
